<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NodeEditorDemo.ViewModels.Nodes"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="60"
             x:Class="NodeEditorDemo.Views.Nodes.CapacitorView"
             x:CompileBindings="True" x:DataType="vm:CapacitorViewModel"
             ClipToBounds="False">
  <Design.DataContext>
    <vm:CapacitorViewModel Value="100µF" />
  </Design.DataContext>

  <Panel>
    <Panel.ContextFlyout>
      <Flyout>
        <StackPanel Width="250" Spacing="10">
          <Label Content="Capacitor Properties" FontWeight="Bold" />

          <StackPanel Spacing="5">
            <Label Content="Value:" />
            <TextBox Text="{Binding Value}" Watermark="e.g., 100µF" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Voltage Rating:" />
            <ComboBox SelectedItem="{Binding Voltage}">
              <ComboBoxItem>6.3V</ComboBoxItem>
              <ComboBoxItem>10V</ComboBoxItem>
              <ComboBoxItem>16V</ComboBoxItem>
              <ComboBoxItem>25V</ComboBoxItem>
              <ComboBoxItem>35V</ComboBoxItem>
              <ComboBoxItem>50V</ComboBoxItem>
              <ComboBoxItem>100V</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Tolerance:" />
            <ComboBox SelectedItem="{Binding Tolerance}">
              <ComboBoxItem>5%</ComboBoxItem>
              <ComboBoxItem>10%</ComboBoxItem>
              <ComboBoxItem>20%</ComboBoxItem>
              <ComboBoxItem>±0.25pF</ComboBoxItem>
              <ComboBoxItem>±0.5pF</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Type:" />
            <ComboBox SelectedItem="{Binding CapacitorType}">
              <ComboBoxItem>Ceramic</ComboBoxItem>
              <ComboBoxItem>Electrolytic</ComboBoxItem>
              <ComboBoxItem>Tantalum</ComboBoxItem>
              <ComboBoxItem>Film</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Package:" />
            <ComboBox SelectedItem="{Binding Package}">
              <ComboBoxItem>0402</ComboBoxItem>
              <ComboBoxItem>0603</ComboBoxItem>
              <ComboBoxItem>0805</ComboBoxItem>
              <ComboBoxItem>1206</ComboBoxItem>
              <ComboBoxItem>Through-hole</ComboBoxItem>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Flyout>
    </Panel.ContextFlyout>

    <!-- Component Background -->
    <Rectangle Width="100" Height="60"
               Fill="#E6E6FA"
               Stroke="#4B0082"
               StrokeThickness="2"
               RadiusX="3" RadiusY="3">
      <Rectangle.Effect>
        <DropShadowEffect BlurRadius="3"
                         OffsetX="1"
                         OffsetY="1"
                         Color="Gray"
                         Opacity="0.3" />
      </Rectangle.Effect>
    </Rectangle>

    <!-- Capacitor Symbol -->
    <Canvas Width="100" Height="60">
      <!-- Connection Lines -->
      <Line StartPoint="10,30" EndPoint="35,30" Stroke="#4B0082" StrokeThickness="2" />
      <Line StartPoint="65,30" EndPoint="90,30" Stroke="#4B0082" StrokeThickness="2" />

      <!-- Capacitor Plates -->
      <Rectangle Width="3" Height="25" Canvas.Left="35" Canvas.Top="17.5" Fill="#4B0082" />
      <Rectangle Width="3" Height="25" Canvas.Left="62" Canvas.Top="17.5" Fill="#4B0082" />

      <!-- Polarization indicator (for electrolytic/tantalum) -->
      <TextBlock Text="+"
                 Canvas.Left="27"
                 Canvas.Top="15"
                 FontSize="12"
                 FontWeight="Bold"
                 Foreground="#DC143C"
                 IsVisible="{Binding IsPolarized}" />

      <!-- Terminal Pads -->
      <Ellipse Width="8" Height="8" Canvas.Left="6" Canvas.Top="26" Fill="#CD7F32" Stroke="#4B0082" StrokeThickness="1" />
      <Ellipse Width="8" Height="8" Canvas.Left="86" Canvas.Top="26" Fill="#CD7F32" Stroke="#4B0082" StrokeThickness="1" />

      <!-- Type indicator -->
      <Border Background="White"
              CornerRadius="2"
              Padding="2"
              Canvas.Left="45"
              Canvas.Top="35">
        <TextBlock Text="{Binding TypeSymbol}"
                   FontSize="8"
                   FontWeight="Bold"
                   Foreground="#4B0082"
                   HorizontalAlignment="Center" />
      </Border>
    </Canvas>

    <!-- Component Label -->
    <Border Background="White"
            CornerRadius="2"
            Padding="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,2,0,0">
      <TextBlock Text="{Binding DisplayValue}"
                 FontSize="10"
                 FontWeight="Bold"
                 Foreground="#4B0082"
                 HorizontalAlignment="Center" />
    </Border>

    <!-- Selection Indicator -->
    <Rectangle Width="100" Height="60"
               Fill="Transparent"
               Stroke="#FF6B35"
               StrokeThickness="2"
               StrokeDashArray="4,2"
               RadiusX="3" RadiusY="3"
               IsVisible="{Binding IsSelected}" />

    <!-- Pin Connection Points -->
    <Ellipse Width="4" Height="4"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             Margin="8,0,0,0"
             Fill="#FF6B35"
             Opacity="0.7" />

    <Ellipse Width="4" Height="4"
             HorizontalAlignment="Right"
             VerticalAlignment="Center"
             Margin="0,0,8,0"
             Fill="#FF6B35"
             Opacity="0.7" />
  </Panel>
</UserControl>
