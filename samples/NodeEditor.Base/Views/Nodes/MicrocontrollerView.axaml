<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NodeEditorDemo.ViewModels.Nodes"
             mc:Ignorable="d" d:DesignWidth="160" d:DesignHeight="120"
             x:Class="NodeEditorDemo.Views.Nodes.MicrocontrollerView"
             x:CompileBindings="True" x:DataType="vm:MicrocontrollerViewModel"
             ClipToBounds="False">
  <Design.DataContext>
    <vm:MicrocontrollerViewModel PartNumber="Arduino Nano" />
  </Design.DataContext>

  <Panel>
    <Panel.ContextFlyout>
      <Flyout>
        <StackPanel Width="320" Spacing="10">
          <Label Content="Microcontroller Properties" FontWeight="Bold" />

          <StackPanel Spacing="5">
            <Label Content="Part Number:" />
            <TextBox Text="{Binding PartNumber}" Watermark="e.g., Arduino Nano" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Type:" />
            <ComboBox SelectedItem="{Binding MicrocontrollerType}">
              <ComboBoxItem>Arduino</ComboBoxItem>
              <ComboBoxItem>ESP32</ComboBoxItem>
              <ComboBoxItem>ESP8266</ComboBoxItem>
              <ComboBoxItem>STM32</ComboBoxItem>
              <ComboBoxItem>PIC</ComboBoxItem>
              <ComboBoxItem>AVR</ComboBoxItem>
              <ComboBoxItem>ARM</ComboBoxItem>
              <ComboBoxItem>RaspberryPi</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Clock Speed:" />
            <TextBox Text="{Binding ClockSpeed}" Watermark="e.g., 16MHz" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Operating Voltage:" />
            <ComboBox SelectedItem="{Binding Voltage}">
              <ComboBoxItem>3.3V</ComboBoxItem>
              <ComboBoxItem>5V</ComboBoxItem>
              <ComboBoxItem>1.8V</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <Label Grid.Row="0" Grid.Column="0" Content="Flash Memory:" />
            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding FlashMemory}" Watermark="32KB" />

            <Label Grid.Row="0" Grid.Column="1" Content="RAM Memory:" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RamMemory}" Watermark="2KB" />

            <Label Grid.Row="0" Grid.Column="2" Content="EEPROM:" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding EepromMemory}" Watermark="1KB" />

            <Label Grid.Row="2" Grid.Column="0" Content="Digital Pins:" />
            <NumericUpDown Grid.Row="3" Grid.Column="0" Value="{Binding DigitalPins}" Minimum="0" Maximum="100" />

            <Label Grid.Row="2" Grid.Column="1" Content="Analog Pins:" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding AnalogPins}" Minimum="0" Maximum="50" />

            <Label Grid.Row="2" Grid.Column="2" Content="PWM Pins:" />
            <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding PwmPins}" Minimum="0" Maximum="50" />
          </Grid>

          <StackPanel Spacing="5">
            <Label Content="Package:" />
            <ComboBox SelectedItem="{Binding Package}">
              <ComboBoxItem>DIP-30</ComboBoxItem>
              <ComboBoxItem>QFN-32</ComboBoxItem>
              <ComboBoxItem>QFN-48</ComboBoxItem>
              <ComboBoxItem>LQFP-48</ComboBoxItem>
              <ComboBoxItem>DIP-40</ComboBoxItem>
              <ComboBoxItem>SBC</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <Separator />

          <StackPanel Spacing="5">
            <Label Content="Firmware Version:" />
            <TextBox Text="{Binding FirmwareVersion}" Watermark="e.g., 1.0.0" />
          </StackPanel>

          <CheckBox Content="Programmed" IsChecked="{Binding IsProgrammed}" />

          <Separator />

          <StackPanel Spacing="5">
            <Label Content="Pin Definitions:" FontWeight="Bold" />
            <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding PinDefinitions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="60,*,80" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" />
                      <TextBlock Grid.Column="1" Text="{Binding Function}" />
                      <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="Gray" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>
      </Flyout>
    </Panel.ContextFlyout>

    <!-- Component Background -->
    <Rectangle Width="160" Height="120"
               Fill="#1E1E2E"
               Stroke="#6366F1"
               StrokeThickness="3"
               RadiusX="8" RadiusY="8">
      <Rectangle.Effect>
        <DropShadowEffect BlurRadius="6"
                         OffsetX="3"
                         OffsetY="3"
                         Color="Gray"
                         Opacity="0.5" />
      </Rectangle.Effect>
    </Rectangle>

    <!-- Microcontroller Board Layout -->
    <Canvas Width="160" Height="120">
      <!-- USB Connector (for Arduino-style boards) -->
      <Rectangle Width="15" Height="8"
                 Canvas.Left="0" Canvas.Top="35"
                 Fill="#C0C0C0"
                 Stroke="#808080"
                 StrokeThickness="1" />

      <!-- Power Jack -->
      <Ellipse Width="12" Height="12"
               Canvas.Left="3" Canvas.Top="60"
               Fill="#000000"
               Stroke="#808080"
               StrokeThickness="1" />

      <!-- Main IC Package -->
      <Rectangle Width="40" Height="30"
                 Canvas.Left="60" Canvas.Top="45"
                 Fill="#2D2D3D"
                 Stroke="#4A5568"
                 StrokeThickness="1"
                 RadiusX="2" RadiusY="2" />

      <!-- IC Label -->
      <TextBlock Text="{Binding DisplaySymbol}"
                 Canvas.Left="75" Canvas.Top="55"
                 FontSize="8"
                 FontWeight="Bold"
                 Foreground="White"
                 HorizontalAlignment="Center" />

      <!-- Crystal Oscillator -->
      <Rectangle Width="8" Height="6"
                 Canvas.Left="105" Canvas.Top="57"
                 Fill="#FFD700"
                 Stroke="#B8860B"
                 StrokeThickness="1" />

      <!-- Pin Headers - Left Side -->
      <ItemsControl>
        <ItemsControl.Items>
          <!-- Digital pins representation -->
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="15" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="22" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="29" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="36" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="43" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="50" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="57" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="64" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="71" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="78" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="85" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="92" Fill="#CD7F32" />
          <Rectangle Width="3" Height="4" Canvas.Left="20" Canvas.Top="99" Fill="#CD7F32" />
        </ItemsControl.Items>
      </ItemsControl>

      <!-- Pin Headers - Right Side -->
      <ItemsControl>
        <ItemsControl.Items>
          <!-- Analog pins representation -->
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="15" Fill="#32CD32" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="22" Fill="#32CD32" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="29" Fill="#32CD32" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="36" Fill="#32CD32" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="43" Fill="#32CD32" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="50" Fill="#32CD32" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="57" Fill="#FF6347" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="64" Fill="#FF6347" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="71" Fill="#FF6347" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="78" Fill="#FF6347" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="85" Fill="#1E90FF" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="92" Fill="#1E90FF" />
          <Rectangle Width="3" Height="4" Canvas.Left="137" Canvas.Top="99" Fill="#1E90FF" />
        </ItemsControl.Items>
      </ItemsControl>

      <!-- LED indicators -->
      <Ellipse Width="4" Height="4"
               Canvas.Left="130" Canvas.Top="25"
               Fill="{Binding IsProgrammed, Converter={StaticResource BoolToColorConverter}}"
               Stroke="White"
               StrokeThickness="0.5" />

      <!-- Reset Button -->
      <Rectangle Width="8" Height="6"
                 Canvas.Left="25" Canvas.Top="8"
                 Fill="#FF4444"
                 Stroke="#CC0000"
                 StrokeThickness="1"
                 RadiusX="1" RadiusY="1" />

      <TextBlock Text="RST"
                 Canvas.Left="27" Canvas.Top="9"
                 FontSize="4"
                 Foreground="White" />
    </Canvas>

    <!-- Component Label -->
    <Border Background="#1E1E2E"
            BorderBrush="White"
            BorderThickness="1"
            CornerRadius="3"
            Padding="4,2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,5,0,0">
      <TextBlock Text="{Binding PartNumber}"
                 FontSize="9"
                 FontWeight="Bold"
                 Foreground="White"
                 HorizontalAlignment="Center" />
    </Border>

    <!-- Status Indicators -->
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,5,5,0">

      <!-- Programming Status -->
      <Border Background="White"
              CornerRadius="8"
              Width="16"
              Height="16"
              Margin="2,0">
        <TextBlock Text="{Binding StatusIndicator}"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="{Binding IsProgrammed, Converter={StaticResource BoolToColorConverter}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>

      <!-- Clock Speed Indicator -->
      <Border Background="#1E1E2E"
              BorderBrush="White"
              BorderThickness="1"
              CornerRadius="2"
              Padding="2,1">
        <TextBlock Text="{Binding ClockSpeed}"
                   FontSize="6"
                   Foreground="White" />
      </Border>
    </StackPanel>

    <!-- Pin Count Info -->
    <Border Background="#1E1E2E"
            BorderBrush="White"
            BorderThickness="1"
            CornerRadius="2"
            Padding="3,1"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="5,0,0,5">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <TextBlock Text="{Binding DigitalPins, StringFormat='D:{0}'}"
                   FontSize="6"
                   Foreground="#CD7F32" />
        <TextBlock Text="{Binding AnalogPins, StringFormat='A:{0}'}"
                   FontSize="6"
                   Foreground="#32CD32" />
        <TextBlock Text="{Binding PwmPins, StringFormat='PWM:{0}'}"
                   FontSize="6"
                   Foreground="#FF6347" />
      </StackPanel>
    </Border>

    <!-- Voltage Indicator -->
    <Border Background="#1E1E2E"
            BorderBrush="White"
            BorderThickness="1"
            CornerRadius="2"
            Padding="3,1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,5,5">
      <TextBlock Text="{Binding Voltage}"
                 FontSize="7"
                 FontWeight="Bold"
                 Foreground="#FFD700" />
    </Border>

    <!-- Selection Indicator -->
    <Rectangle Width="160" Height="120"
               Fill="Transparent"
               Stroke="#FF6B35"
               StrokeThickness="3"
               StrokeDashArray="6,3"
               RadiusX="8" RadiusY="8"
               IsVisible="{Binding IsSelected}" />

    <!-- Main Pin Connection Points -->
    <ItemsControl>
      <ItemsControl.Items>
        <!-- Left side pins -->
        <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,13,0,0" Fill="#FF6B35" Opacity="0.8" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,20,0,0" Fill="#FF6B35" Opacity="0.8" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,27,0,0" Fill="#FF6B35" Opacity="0.8" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,34,0,0" Fill="#FF6B35" Opacity="0.8" />

        <!-- Right side pins -->
        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,18,0" Fill="#FF6B35" Opacity="0.8" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,18,0" Fill="#FF6B35" Opacity="0.8" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,27,18,0" Fill="#FF6B35" Opacity="0.8" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,18,0" Fill="#FF6B35" Opacity="0.8" />

        <!-- Power pins -->
        <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,20" Fill="#FFD700" Opacity="0.8" />
        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,20" Fill="#FF0000" Opacity="0.8" />
      </ItemsControl.Items>
    </ItemsControl>
  </Panel>
</UserControl>
