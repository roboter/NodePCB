<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NodeEditorDemo.ViewModels.Nodes"
             mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="80"
             x:Class="NodeEditorDemo.Views.Nodes.TransistorView"
             x:CompileBindings="True" x:DataType="vm:TransistorViewModel"
             ClipToBounds="False">
  <Design.DataContext>
    <vm:TransistorViewModel PartNumber="2N2222" />
  </Design.DataContext>

  <Panel>
    <Panel.ContextFlyout>
      <Flyout>
        <StackPanel Width="280" Spacing="10">
          <Label Content="Transistor Properties" FontWeight="Bold" />

          <StackPanel Spacing="5">
            <Label Content="Part Number:" />
            <TextBox Text="{Binding PartNumber}" Watermark="e.g., 2N2222" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Configuration:" />
            <ComboBox SelectedItem="{Binding Configuration}">
              <ComboBoxItem>BJT</ComboBoxItem>
              <ComboBoxItem>MOSFET</ComboBoxItem>
              <ComboBoxItem>JFET</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Type:" />
            <ComboBox SelectedItem="{Binding TransistorType}">
              <ComboBoxItem>NPN</ComboBoxItem>
              <ComboBoxItem>PNP</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Max Collector Current:" />
            <TextBox Text="{Binding MaxCollectorCurrent}" Watermark="e.g., 800mA" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Max Collector Voltage:" />
            <TextBox Text="{Binding MaxCollectorVoltage}" Watermark="e.g., 40V" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="hFE (Current Gain):" />
            <TextBox Text="{Binding Hfe}" Watermark="e.g., 100-300" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Label Content="Package:" />
            <ComboBox SelectedItem="{Binding Package}">
              <ComboBoxItem>TO-92</ComboBoxItem>
              <ComboBoxItem>TO-220</ComboBoxItem>
              <ComboBoxItem>TO-263</ComboBoxItem>
              <ComboBoxItem>SOT-23</ComboBoxItem>
              <ComboBoxItem>SOT-223</ComboBoxItem>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Flyout>
    </Panel.ContextFlyout>

    <!-- Component Background -->
    <Rectangle Width="100" Height="80"
               Fill="#F0F8FF"
               Stroke="#4169E1"
               StrokeThickness="2"
               RadiusX="5" RadiusY="5">
      <Rectangle.Effect>
        <DropShadowEffect BlurRadius="4"
                         OffsetX="2"
                         OffsetY="2"
                         Color="Gray"
                         Opacity="0.4" />
      </Rectangle.Effect>
    </Rectangle>

    <!-- Transistor Symbol -->
    <Canvas Width="100" Height="80">
      <!-- Base connection line -->
      <Line StartPoint="10,40" EndPoint="35,40" Stroke="#4169E1" StrokeThickness="2" />

      <!-- Collector connection line -->
      <Line StartPoint="50,15" EndPoint="50,25" Stroke="#4169E1" StrokeThickness="2" />
      <Line StartPoint="50,15" EndPoint="90,15" Stroke="#4169E1" StrokeThickness="2" />

      <!-- Emitter connection line -->
      <Line StartPoint="50,55" EndPoint="50,65" Stroke="#4169E1" StrokeThickness="2" />
      <Line StartPoint="50,65" EndPoint="90,65" Stroke="#4169E1" StrokeThickness="2" />

      <!-- Base vertical line -->
      <Line StartPoint="35,25" EndPoint="35,55" Stroke="#4169E1" StrokeThickness="3" />

      <!-- Collector line from base -->
      <Line StartPoint="35,30" EndPoint="50,25" Stroke="#4169E1" StrokeThickness="2" />

      <!-- Emitter line from base -->
      <Line StartPoint="35,50" EndPoint="50,55" Stroke="#4169E1" StrokeThickness="2" />

      <!-- Arrow for emitter (direction depends on NPN/PNP) -->
      <Polygon Points="47,52 53,55 47,58"
               Fill="#4169E1"
               Stroke="#4169E1"
               StrokeThickness="1" />

      <!-- Pin Labels -->
      <TextBlock Text="B"
                 Canvas.Left="5"
                 Canvas.Top="33"
                 FontSize="9"
                 FontWeight="Bold"
                 Foreground="#4169E1" />

      <TextBlock Text="C"
                 Canvas.Left="93"
                 Canvas.Top="8"
                 FontSize="9"
                 FontWeight="Bold"
                 Foreground="#4169E1" />

      <TextBlock Text="E"
                 Canvas.Left="93"
                 Canvas.Top="58"
                 FontSize="9"
                 FontWeight="Bold"
                 Foreground="#4169E1" />

      <!-- Terminal Pads -->
      <Ellipse Width="6" Height="6" Canvas.Left="7" Canvas.Top="37" Fill="#CD7F32" Stroke="#4169E1" StrokeThickness="1" />
      <Ellipse Width="6" Height="6" Canvas.Left="87" Canvas.Top="12" Fill="#CD7F32" Stroke="#4169E1" StrokeThickness="1" />
      <Ellipse Width="6" Height="6" Canvas.Left="87" Canvas.Top="62" Fill="#CD7F32" Stroke="#4169E1" StrokeThickness="1" />

      <!-- Type indicator circle -->
      <Ellipse Width="30" Height="30"
               Canvas.Left="35"
               Canvas.Top="25"
               Fill="Transparent"
               Stroke="#4169E1"
               StrokeThickness="2" />

      <!-- Arrow direction indicator -->
      <TextBlock Text="{Binding ArrowDirection}"
                 Canvas.Left="46"
                 Canvas.Top="32"
                 FontSize="12"
                 FontWeight="Bold"
                 Foreground="#DC143C"
                 HorizontalAlignment="Center" />
    </Canvas>

    <!-- Component Label -->
    <Border Background="White"
            CornerRadius="2"
            Padding="3,1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,2,0,0">
      <TextBlock Text="{Binding DisplaySymbol}"
                 FontSize="9"
                 FontWeight="Bold"
                 Foreground="#4169E1"
                 HorizontalAlignment="Center" />
    </Border>

    <!-- Part Number Label -->
    <Border Background="White"
            CornerRadius="2"
            Padding="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,2">
      <TextBlock Text="{Binding PartNumber}"
                 FontSize="8"
                 Foreground="#4169E1"
                 HorizontalAlignment="Center" />
    </Border>

    <!-- Selection Indicator -->
    <Rectangle Width="100" Height="80"
               Fill="Transparent"
               Stroke="#FF6B35"
               StrokeThickness="2"
               StrokeDashArray="4,2"
               RadiusX="5" RadiusY="5"
               IsVisible="{Binding IsSelected}" />

    <!-- Pin Connection Points -->
    <Ellipse Width="4" Height="4"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             Margin="8,0,0,0"
             Fill="#FF6B35"
             Opacity="0.7" />

    <Ellipse Width="4" Height="4"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             Margin="0,15,8,0"
             Fill="#FF6B35"
             Opacity="0.7" />

    <Ellipse Width="4" Height="4"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="0,0,8,15"
             Fill="#FF6B35"
             Opacity="0.7" />
  </Panel>
</UserControl>
